{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.horrible.dashboard",
  "productName": "Horrible Dashboard",
  "executableName": "horrible-dashboard",
  "directories": {
    "output": "../../dist-electron"
  },
  "files": ["dist/**/*", "placeholder.html"],
  "extraResources": [
    {
      "from": "../../apps/web/dist",
      "to": "web",
      "filter": ["**/*"]
    },
    {
      "from": "../../apps/desktop/src-tauri/backend-runtime",
      "to": "backend-runtime",
      "filter": ["**/*"]
    }
  ],
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Utility",
    "icon": "../../apps/desktop/src-tauri/icons/icon.png",
    "synopsis": "Desktop dashboard client",
    "description": "High-performance desktop dashboard client"
  },
  "win": {
    "target": ["nsis", "zip"],
    "icon": "../../apps/desktop/src-tauri/icons/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "publish": {
    "provider": "github",
    "owner": "ConstCorrectness",
    "repo": "horrible-dashboard"
  }
}
