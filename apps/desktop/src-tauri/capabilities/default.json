{
  "$schema": "gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main", "ws-*"],
  "permissions": [
    "core:default",
    "allow-backend-status",
    "allow-window-is-fullscreen",
    "allow-window-set-fullscreen",
    "allow-window-toggle-fullscreen",
    "allow-window-minimize",
    "allow-window-is-maximized",
    "allow-window-toggle-maximize",
    "allow-window-close",
    "allow-window-start-resize-dragging",
    "allow-window-open-workspace",
    "allow-browser-open-url",
    "allow-open-external",
    "allow-shortcuts-register",
    "allow-shortcuts-unregister-all",
    "global-shortcut:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
