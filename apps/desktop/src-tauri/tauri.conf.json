{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "horrible-dashboard",
  "version": "0.2.0",
  "identifier": "com.horrible.dashboard",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @horrible/web dev",
    "frontendDist": "../../web/dist",
    "beforeBuildCommand": "pnpm --filter @horrible/web build"
  },
  "app": {
    "windows": [
      {
        "title": "horrible-dashboard",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png"],
    "resources": ["backend-runtime/**/*"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDRDRBNDQ2REQzMzVEQkQKUldTOVhUUGRScVRVM0JwMkJKUUllaG42T0w4a25KdUo3VzBrWWNCc2pkRXpsMG41MHZTZkJPSzYK",
      "endpoints": [
        "https://github.com/horriblecpp/horrible-dashboard/releases/download/updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
