{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @horrible/web build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://horrible-hub.fly.dev/api/:path*" },
    { "source": "/hub/:path*", "destination": "https://horrible-hub.fly.dev/hub/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
