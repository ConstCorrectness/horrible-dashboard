    },
    {
      "kind": "rust_iron",
      "match": ["dust2_metal_iron_rusted"]
    },
    {
      "kind": "burlap",
      "match": ["dust2_canopy_", "dust2_sack_burlap", "mirage_canopy_", "mirage_sack_burlap", "inferno_canopy_", "inferno_sandbag", "nuke_sandbag"]
