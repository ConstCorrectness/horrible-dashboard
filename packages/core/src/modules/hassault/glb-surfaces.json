{
  "why": "Which procedural surface a GLB map material gets, read by both clients (glb-surfaces.ts, apps/native-fps/src/textures3d.rs). Rules are lowercase substrings of the material name, tried in order, first match wins. 'none' means no detail texture: emissive, liquid, foliage and printed surfaces keep their authored colour and only get the world-space grain. `photoKinds` are the kinds backed by CC0 photographed maps (colour, normal, roughness) in apps/web/public/maps/textures/, matched only by Dust II's own `dust2_`, Mirage's own `mirage_`, Inferno's own `inferno_`, Nuke's own `nuke_`, Office's own `office_`, Bank's own `bank_` and Assault's own `assault_` material names so other maps are untouched; see tools/hassault_process_textures.py.",
  "default": "concrete",
  "rules": [
    {
      "kind": "none",
      "match": [
        "glow",
        "flame",
        "lamp",
        "_led",
        "fluor",
        "troffer",
        "screen",
        "display",
        "phosphor",
        "crt",
        "water",
        "frond",
        "leaves",
        "foliage",
        "coolant",
        "siren",
        "headlight",
        "reflector",
        "stripe",
        "canvas",
        "painting",
        "sign",
        "leather",
        "tire",
        "rubber",
        "plastic",
        "paper",
        "currency",
        "book",
        "shrinkwrap"
      ]
    },
    {
      "kind": "limewash",
      "match": ["dust2_sandstone_light", "mirage_sandstone_light", "mirage_moorish_plaster", "inferno_tuscan_stucco_warm"]
    },
    {
      "kind": "sandstone",
      "match": ["dust2_sandstone_ochre", "dust2_sandstone_dark", "mirage_sandstone_ochre", "inferno_tuscan_stucco_ochre", "inferno_limestone"]
    },
    {
      "kind": "paving",
      "match": ["dust2_limestone_paving", "mirage_sandstone_paving", "inferno_cobblestone_"]
    },
    {
      "kind": "dunesand",
