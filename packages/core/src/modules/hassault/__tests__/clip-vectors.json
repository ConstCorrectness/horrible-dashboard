    { "clip": "death_from_the_front", "once": true },
    { "clip": "death_from_back_headshot", "once": true },
    { "clip": "reloading", "once": true },
    { "clip": "firing_rifle", "once": true },
    { "clip": "running_jump", "once": true },
    { "clip": "standard_walk", "once": false },
    { "clip": "crouch_walking", "once": false },
    { "clip": "rifle_aiming_idle", "once": false },
    { "clip": "walking_backwards", "once": false }
  ],
