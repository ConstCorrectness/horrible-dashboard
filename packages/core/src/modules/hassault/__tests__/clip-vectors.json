{
  "comment": "Shared vectors for operator clip selection, replayed by both clients. The browser's selectLocomotion/selectDeath/fadeFor/isOneShot (models/clips.ts) and the native client's crate::clips (apps/native-fps/src/clips.rs) are two implementations of one decision, the same way the physics is three. This fixture pins that they AGREE; each side's own tests pin that it is correct. A case added here must be added nowhere else.",
  "locomotion": [
    {
      "why": "death overrides everything - killed mid-run is dying, not running",
      "state": {
        "alive": false,
        "ground": true,
        "crouch": 0,
        "speed": 8
      },
      "clip": "death_from_the_front"
    },
    {
      "why": "airborne is checked after death",
      "state": {
        "alive": true,
        "ground": false,
        "crouch": 0,
        "speed": 12
      },
      "clip": "running_jump"
    },
    {
      "why": "a dead player in the air is dead, not jumping",
      "state": {
        "alive": false,
        "ground": false,
        "crouch": 0,
        "speed": 12
      },
      "clip": "death_from_the_front"
    },
    {
      "why": "crouched and moving",
      "state": {
        "alive": true,
        "ground": true,
        "crouch": 1,
        "speed": 3
      },
      "clip": "crouch_walking"
    },
    {
      "why": "crouched and still - there is no crouched idle, so the kneel stands in",
      "state": {
        "alive": true,
        "ground": true,
        "crouch": 1,
        "speed": 0
      },
      "clip": "rifle_crouch_walk_to_kneel"
    },
    {
      "why": "crouch is a fraction, and 0.5 is NOT crouched - the boundary both sides must agree on",
      "state": {
        "alive": true,
        "ground": true,
        "crouch": 0.5,
        "speed": 3
      },
      "clip": "rifle_aiming_idle"
    },
    {
      "why": "just above the crouch boundary",
      "state": {
        "alive": true,
        "ground": true,
        "crouch": 0.51,
        "speed": 3
      },
      "clip": "crouch_walking"
    },
    {
      "why": "crouched at exactly IDLE_SPEED is still - the test is strictly greater",
      "state": {
        "alive": true,
        "ground": true,
        "crouch": 1,
        "speed": 0.6
      },
      "clip": "rifle_crouch_walk_to_kneel"
    },
    {
      "why": "crouched just over IDLE_SPEED is moving",
      "state": {
        "alive": true,
        "ground": true,
        "crouch": 1,
        "speed": 0.61
      },
      "clip": "crouch_walking"
    },
    {
      "why": "standing still",
      "state": {
        "alive": true,
        "ground": true,
        "crouch": 0,
        "speed": 0
      },
      "clip": "rifle_aiming_idle"
    },
    {
      "why": "standing and walking - the legs are solved, the torso keeps aiming",
      "state": {
        "alive": true,
        "ground": true,
        "crouch": 0,
        "speed": 5
      },
      "clip": "rifle_aiming_idle"
    },
    {
      "why": "standing at a full run - still the aiming pose, whatever the speed",
      "state": {
        "alive": true,
        "ground": true,
        "crouch": 0,
        "speed": 18
      },
      "clip": "rifle_aiming_idle"
    }
