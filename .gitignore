# Sample plugins commit their built entry so the marketplace demo works
# on a fresh clone without a build step.
!examples/plugins/*/dist/

# Tauri / Rust
src-tauri/target/
apps/desktop/src-tauri/gen/

# App local data (HORRIBLE_DATA_DIR — node identity key, peers, settings, vectordb).
# Covers the default `.data/` and any sibling data dir (e.g. `.data-peer2/` for a
# second local node during peer-fabric testing). Never commit these — they hold a
# private Ed25519 node key.
.data/
.data-*/

# Regenerable bytes (`paths.cache_dir()` — `<repo>/.cache` in a checkout).
.cache/

# Claude Code local overrides
.claude/settings.local.json
.claude/.docs_check_state
.claude/.smoke-*-pid
.claude/worktrees/

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# Backend runtime logs (backend/app.py writes logs/backend.log)
logs/

# JVM heap/crash dumps. A Gradle OOM while building apps/mobile-android drops a
# multi-hundred-MB java_pid*.hprof wherever the daemon was launched — often here.
*.hprof
hs_err_pid*.log
replay_pid*.log

# OS specific
.DS_Store
Thumbs.db

# C# / .NET
[Bb]in/
[Oo]bj/
*.suo
*.user
*.userossc
*.sln.docstates


# ------------------------------------------------------------------------------
# Android & Gradle
# ------------------------------------------------------------------------------
# Gradle build directory & cache
.gradle/
**/build/
!**/src/main/build/

# Local configuration & SDK paths (contains local machine path to Android SDK)
local.properties

# Android Studio / IntelliJ local workspace & user configurations
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml

# Native build artifacts (NDK / C++)
.cxx/
.externalNativeBuild/

# Android signing keys & keystores (CRITICAL - never commit private keys!)
*.keystore
*.jks
*.p12

# Android Studio temporary files
*.apk
*.ap_
*.aab
*.dex

# Google Services config (if using Firebase/Google APIs with private keys later)
# google-services.json

# ------------------------------------------------------------------------------
# AI Agent Local Artifacts
# ------------------------------------------------------------------------------
.artifacts/


CLAUDE.local.md
# The bundled Python backend runtime (scripts/build-backend-runtime.mjs): a
# relocatable CPython plus every dependency, ~1 GB. A build output, rebuilt per
# release by CI. The .gitkeep is committed so tauri.conf.json's resource glob
# always matches something — see the note inside it.
apps/desktop/src-tauri/backend-runtime/*
!apps/desktop/src-tauri/backend-runtime/.gitkeep

# 3D Model Raw Binaries & DCC Project Files (prevent pushing to git)
*.fbx
*.blend
*.blend1
*.obj
*.dae
*.max
*.3ds

# Raw character/weapon art (~1 GB): source inputs
assets/horribleAssault/*
!assets/horribleAssault/README.md
!assets/horribleAssault/maps/
!assets/horribleAssault/maps/**
!assets/manifest.json

# Compiled HorribleAssault 3D models (downloaded on demand or via `pnpm assets:pull`)
apps/web/public/hassault-*.glb
apps/web/public/models/*.glb


