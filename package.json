{
  "name": "horrible-dashboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @horrible/web dev",
    "dev:lan": "node scripts/dev.mjs --host 0.0.0.0",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build": "pnpm --filter @horrible/web build",
    "build:desktop": "pnpm --filter @horrible/desktop build",
    "build:backend-runtime": "node scripts/build-backend-runtime.mjs",
    "build:icons": "node scripts/build_icons.mjs",
    "build:hassault": "node scripts/build-hassault.mjs --release",
    "build:hassault:debug": "node scripts/build-hassault.mjs --debug",
    "build:hassault-character": "node scripts/build_hassault_character.mjs",
    "build:hassault-weapon": "node scripts/build_hassault_weapon.mjs",
    "build:hassault-arms": "node scripts/build_hassault_arms.mjs",
    "build:hassault-fal": "node scripts/build_hassault_fal.mjs",
    "assets:check": "node scripts/assets.mjs check",
    "assets:pull": "node scripts/assets.mjs pull",
    "assets:pack": "node scripts/assets.mjs pack",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.5.0",
    "sharp": "^0.34.5",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0"
  }
}
