{
  "name": "horrible-dashboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @horrible/web dev",
    "dev:lan": "node scripts/dev.mjs --host 0.0.0.0",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build": "pnpm --filter @horrible/web build",
    "build:desktop": "pnpm --filter @horrible/desktop build",
    "build:icons": "node scripts/build_icons.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.5.0",
    "sharp": "^0.34.5",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0"
  }
}
