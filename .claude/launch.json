{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "web-ui",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:web"],
      "port": 5173,
      "autoPort": true,
      "env": {
        "HORRIBLE_DEV_BACKEND_PORT": "8100"
      }
    },
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "backend.app:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8100",
        "--reload",
        "--reload-dir",
        "backend",
        "--reload-exclude",
        "logs/*"
      ],
      "port": 8100
    },
    {
      "name": "docs",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@horrible/docs", "start", "--no-open"],
      "port": 3000
    },
    {
      "name": "lobby",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "backend.modules.network.lobby_server:app",
        "--port",
        "9000"
      ],
      "port": 9000
    },
    {
      "name": "gameserver",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "backend.games_server.app:app", "--port", "9200"],
      "port": 9200
    },
    {
      "name": "gameserver-web",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "backend.games_server.app:app", "--port", "9200"],
      "port": 9200,
      "env": {
        "GAMES_WEB_ORIGINS": "http://localhost:5180,http://127.0.0.1:5180"
      }
    },
    {
      "name": "assault-web-prodlike",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@horrible/assault-web", "dev"],
      "port": 5180,
      "env": {
        "VITE_BACKEND_URL": "http://127.0.0.1:9200"
      }
    },
    {
      "name": "assault-web-dist",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@horrible/assault-web",
        "exec",
        "vite",
        "preview",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    },
    {
      "name": "share-relay",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "backend.share_relay.app:app", "--port", "9100"],
      "port": 9100
    }
  ]
}
