{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "docs",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@horrible/docs", "start", "--no-open"],
      "port": 3000
    },
    {
      "name": "lobby",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "backend.modules.network.lobby_server:app",
        "--port",
        "9000"
      ],
      "port": 9000
    },
    {
      "name": "gameserver",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "backend.games_server.app:app", "--port", "9200"],
      "port": 9200
    },
    {
      "name": "share-relay",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "backend.share_relay.app:app", "--port", "9100"],
      "port": 9100
    }
  ]
}
